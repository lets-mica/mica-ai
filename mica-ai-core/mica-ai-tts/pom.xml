<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>mica-ai-tts</artifactId>
    <name>${project.artifactId}</name>
    <url>https://www.dreamlu.net</url>
    <description>Kokoro TTS 纯 ONNXRuntime 语音合成推理（Java 17 移植版）</description>

    <parent>
        <groupId>net.dreamlu</groupId>
        <artifactId>mica-ai</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <dependencies>
        <!-- mica-ai common -->
        <dependency>
            <groupId>net.dreamlu</groupId>
            <artifactId>mica-ai-common</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- ONNX Runtime Java API -->
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
        </dependency>
        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            可选 G2P 库依赖（houbb/pinyin）。
            如需使用 net.dreamlu.mica.ai.tts.g2p.HoubbPinyinG2P（支持多音字、中文分词、繁简体），
            请在使用方项目中显式引入该依赖。本模块使用反射调用，避免强制依赖。
        -->
        <dependency>
            <groupId>com.github.houbb</groupId>
            <artifactId>pinyin</artifactId>
            <version>0.4.0</version>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>
